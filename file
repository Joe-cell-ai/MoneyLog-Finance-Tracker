+        income: Boolean = false,
+        source: String = "SMS auto import",
+        key: String = "sms-import:ax-icicib-s:1762300000000:-12345",
+        origin: String = CategoryOrigin.UNKNOWN,
+        amount: Long = 100L,
+        date: String = "2026-11-05"
+    ) = Transaction(
